{
  "manifest_version": 3,
  "name": "Link Radar for X — リンクの正体判定",
  "version": "0.7.0",
  "description": "そのリンク、開く前に正体がわかります。Xのタイムラインとリプ欄のリンクを判定し、アダルトや連投スパムは画像を覆って警告。有料記事やアフィリンクも見分けます。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Link Radar 設定"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["src/content.js"],
      "css": ["src/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
