{
  "manifest_version": 3,
  "name": "Link Radar for X — リンクの正体判定",
  "version": "0.6.0",
  "description": "Xのリンクを開く前に判定。有料記事(🔒)/アダルト(🔞)/連投スパム(🚨)/アフィ(💰)/短縮(🔗)/広告過多(📊)などを検出し、該当ポストの画像を赤で覆います。引用元も判定。",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Link Radar 設定"
  },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "js": ["src/content.js"],
      "css": ["src/badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
